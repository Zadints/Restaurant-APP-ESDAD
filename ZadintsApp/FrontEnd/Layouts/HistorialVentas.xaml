<Page x:Class="App.Components.Layouts.Content.HistorialVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App.Components.Layouts.Content"
        mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="1020"
        Title="HistorialVentas">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="38*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0" Grid.Column="1">

            <TextBlock Text="Desde:"
               VerticalAlignment="Center"/>

            <DatePicker x:Name="dpInicio"
                Margin="5,0" Height="28" Width="168"/>

            <TextBlock Text="Hasta:"
               VerticalAlignment="Center"/>

            <DatePicker x:Name="dpFin"
                Margin="5,0" Height="25"/>

            <Button Content="Buscar"
           Background="#A0A532"
Foreground="White"
Width="127"
FontSize="14.5"
FontWeight="SemiBold" 
                    Margin="0,0,10,0"
Template="{DynamicResource ButtonTwo}"
            Click="BtnBuscar_Click"/>

            <Button Content="Mostrar Todo"
                       Background="#A0A532"
Foreground="White"
Width="127"
FontSize="14.5"
FontWeight="SemiBold" 
                    Template="{DynamicResource ButtonTwo}"
                    Margin="0,0,10,0"
            Click="BtnMostrarTodo_Click"/>

        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <GroupBox Grid.Column="1"
                      Header="Detalle"
                      Margin="206,0,0,0">

                <StackPanel Margin="10">

                    <TextBlock x:Name="lblTicket"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="lblFecha"
                               Margin="0,5"/>

                    <TextBlock x:Name="lblTotal"
                               Margin="0,5"
                               FontWeight="Bold"/>

                    <Separator Margin="0,10"/>

                    <ListBox x:Name="lstDetalle"/>

                </StackPanel>

            </GroupBox>

        </Grid>
        <Border Grid.Column="0"
            Background="#FAFAFA"
            CornerRadius="20"
            Margin="10,10,495,0"
            Effect="{DynamicResource ShadowStyle2}"
            Padding="18" Grid.Row="1" Grid.ColumnSpan="2">

            <ListBox x:Name="lstVentas" Background="#F9F9F9"
                     SelectionChanged="lstVentas_SelectionChanged"
BorderBrush="#EEEEEE" BorderThickness="1" Padding="8" Margin="0,0,3,-8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#EEEEEE"
                BorderThickness="1" Background="#F0F0F0">
                                <Image Source="{Binding Foto64}" Height="60"
                    Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="S/. " FontSize="12" Foreground="#E8440A"/>
                                    <TextBlock Text="{Binding Total, StringFormat=F2}"
                        FontSize="12" Foreground="#E8440A"/>
                                    <TextBlock Text="  |  Ticket: " FontSize="12" Foreground="#555"/>
                                    <TextBlock Text="{Binding NumeroTicket}" FontSize="12" Foreground="#555"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFE0D8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
        <Label 
            x:Name="lblTitleGlobal" 
            Content="Historial de ventas" 
            HorizontalAlignment="Left" 
            Margin="23,0,0,0" 
            VerticalAlignment="Center" 
            AutomationProperties.Name="" 
            AutomationProperties.HelpText="" 
            Foreground="{DynamicResource FontColor}" 
            FontSize="25" 
            FontWeight="Bold" Height="43" Width="238"/>
    </Grid>
</Page>
